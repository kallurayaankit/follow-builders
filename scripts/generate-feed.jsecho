import fs from 'fs/promises';  import { createRequire } from 'module';  const require = createRequire(import.meta.url);  const lockFile = require('proper-lockfile');  const SOURCES = JSON.parse(await fs.readFile('config/default-sources.json', 'utf-8'));  const STATE_FILE = 'state-feed.json';  async function loadState() {    try { return JSON.parse(await fs.readFile(STATE_FILE, 'utf-8')); } catch { return {}; }  }  async function saveState(state) {    await fs.writeFile(STATE_FILE, JSON.stringify(state, null, 2));  }  async function fetchBlogs() {    const state = await loadState();    const articles = [];    for (const blog of SOURCES.blogs) {      try {        const res = await fetch(blog.url);        const html = await res.text();        const linkRegex = /<a\s+(?:[>]*?\s+)?href="([^"]*)"[^>]*^>/gi; >> scripts\generate-feed.jsecho       const matches = [...html.matchAll(linkRegex)]; >> scripts\generate-feed.jsecho       for (const m of matches) { >> scripts\generate-feed.jsecho         const href = m[1]; >> scripts\generate-feed.jsecho         if (href.startsWith('/engineering/') ^|^| href.startsWith('/blog/')) { >> scripts\generate-feed.jsecho           const fullUrl = new URL(href, blog.url).href; >> scripts\generate-feed.jsecho           if (!articles.find(a =^> a.url === fullUrl)) { >> scripts\generate-feed.jsecho             articles.push({ blog: blog.name, url: fullUrl, scraped_at: new Date().toISOString() }); >> scripts\generate-feed.jsecho           } >> scripts\generate-feed.jsecho         } >> scripts\generate-feed.jsecho       } >> scripts\generate-feed.jsecho     } catch (err) { console.error(err); } >> scripts\generate-feed.jsecho   } >> scripts\generate-feed.jsecho   return articles; >> scripts\generate-feed.jsecho } >> scripts\generate-feed.jsecho. >> scripts\generate-feed.jsecho const blogs = await fetchBlogs(); >> scripts\generate-feed.jsecho const feedBlogs = { generated: new Date().toISOString(), articles: blogs }; >> scripts\generate-feed.jsecho await fs.writeFile('feed-blogs.json', JSON.stringify(feedBlogs, null, 2)); >> scripts\generate-feed.jsecho console.log('Blog feed generated.'); >> scripts\generate-feed.js
